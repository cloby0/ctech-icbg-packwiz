	quest_links: [ ]
	quests: [
			{
				dependencies: [ ]
				description: [
					"this is the magic side: no boilers, no voltage, no soot -- cauldrons, essentia, life essence, and rituals. four pillars carry the tree at this stage: &6botania&r (petals/livingrock), &doccultism&r (spiritfire/spirits), &2malum&r (soul-hunting/spirit altar), and &4blood magic&r (the LP economy). &9mana & artifice&r and &dmagichem&r don't open until apprentice -- they're aether-gated, and the aether is what this whole chapter builds toward."
					""
					"magic and tech trade materials constantly in this pack. even a pure mage should check the other book now and then."
				]
				id: "6135CDA5AA58E147"
				shape: "diamond"
				subtitle: "the easy way out"
				tasks: [{
					id: "4FD1872CC8EEE445"
					title: "Magic!"
					type: "checkmark"
				}]
				title: "Magic!"
				x: 0.0d
				y: 0.0d
			}
			{
				dependencies: ["6135CDA5AA58E147"]
				description: [
					"hexerei's &6mixing cauldron&r is your first magical workstation. 2x iron plate, `gtceu:iron_bolt`, a vanilla cauldron, 2x gold plate, 2x wooden slab, damaging a wrench."
					""
					"needs a heat source underneath and the right liquid inside -- lava for most of this tier's recipes, water for a couple. the recipe's in JEI."
				]
				id: "7F807C243FE802BB"
				shape: "rsquare"
				size: 1.5d
				subtitle: "The cauldron awakens"
				tasks: [{
					item: "hexerei:mixing_cauldron"
					id: "66FAE6BF81926F73"
					type: "item"
				}]
				title: "Double, Double"
				x: 1.5d
				y: 0.0d
			}
			{
				dependencies: ["6135CDA5AA58E147"]
				description: [
					"place it, fill with water (right-click or throw in a bucket), throw in &6mystical petals&r, then throw a seed to finish. every botania flower is made here."
					""
					"&6mystical petals&r are this tier's elemental currency, standing in for the magichem essentia you won't have until apprentice: &cfire = red&r, &9water = blue&r, &2earth = brown&r, &7air = white&r. collect one of each -- you'll be brewing with all four constantly."
				]
				id: "3AFE4C91FE577BFD"
				shape: "rsquare"
				subtitle: "what and what is next"
				tasks: [
				{
					item: "botania:apothecary_default"
					id: "092ACC432226F87F"
					type: "item"
				}
				{
					item: "botania:red_petal"
