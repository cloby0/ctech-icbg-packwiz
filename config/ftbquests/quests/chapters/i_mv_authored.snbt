			]
			title: "Silicon Route"
			x: 0.0d
			y: -9.0d
		}
		{
			dependencies: ["1C00F1C2E3D40017"]
			description: [
				"the &6MV circuit assembler&r makes circuits at this tier and above far cheaper than hand-crafting."
				""
				"feed it plastic PCBs, silicon wafers, transistors, capacitors, and inductors from the &6MV assembler&r. the &aadvanced integrated circuit&r (HV tier) is the exit ticket from MV."
			]
			id: "1C00F1C2E3D4001B"
