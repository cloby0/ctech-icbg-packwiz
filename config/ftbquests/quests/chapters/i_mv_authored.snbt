		{
			dependencies: ["1C00F1C2E3D40013"]
			description: [
				"&astainless steel&r needs &3chromium&r, &3manganese&r, &3iron&r, and &3nickel&r. chromium comes from electrolyzing ruby or red garnet dust. manganese from pyrolusite ore veins."
				""
				"get the chromium line running while the kanthal EBF is warming up. stainless is the HV gate material and takes time to produce in volume."
			]
			id: "1C00F1C2E3D40036"
			shape: "rsquare"
			size: 0.66d
			subtitle: "prep the alloy before you need it"
			tasks: [{
