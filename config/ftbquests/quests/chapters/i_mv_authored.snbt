					type: "item"
				}
			]
			title: "Polyethylene"
			x: 0.0d
			y: -6.0d
		}
		{
			dependencies: ["1C00F1C2E3D4000F"]
			description: [
				"&akanthal&r is an iron + aluminium + chromium alloy. mix it in the &6MV mixer&r, shape it into 16 coil blocks, and install them to upgrade the EBF from 1800K to 2700K."
				""
				"2700K unlocks silicon boule and several alloys the cupronickel coils can't touch. higher-temp recipes produce &ahot ingots&r that can't be used directly - the vacuum freezer handles that, and you'll build one at HV."
			]
			icon: "gtceu:mv_mixer"
			id: "1C00F1C2E3D40013"
			shape: "square"
			size: 0.75d
			subtitle: "hotter furnace, better metal"
			tasks: [
				{
					id: "1C00F1C2E3D40014"
					item: "gtceu:mv_mixer"
					type: "item"
				}
				{
					count: 16L
					id: "1C00F1C2E3D40015"
					item: "gtceu:kanthal_coil_block"
					type: "item"
				}
			]
			title: "Kanthal Coils"
			x: 0.0d
			y: -7.5d
		}
		{
			dependencies: ["1C00F1C2E3D40013"]
			description: [
				"&asilicon boule&r: 32 silicon dust + gallium arsenide in the EBF at 2700K (about 7.5 min). gallium from sphalerite centrifuge or bauxite chemical bath."
				""
				"the &6MV laser engraver&r engraves wafers into specific chip types. the &6MV cutter&r slices the boule into 16 wafers. build both before starting the circuit line, and keep a wafer buffer ready."
			]
			icon: "gtceu:mv_laser_engraver"
