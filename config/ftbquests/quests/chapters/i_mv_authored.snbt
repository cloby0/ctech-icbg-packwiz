		}
		{
			dependencies: ["1C00F1C2E3D40002"]
			description: [
				"the &6MV steam turbine&r produces 128 EU/t from 64 mB/t of steam. a &3large steel boiler&r outputs 900 steam/t, enough to run about 14 turbines at once. build as many as you need."
				""
				"same rule as LV: fill the boiler before lighting it. cold water into a hot dry boiler ends badly."
			]
			id: "1C00F1C2E3D40004"
			shape: "square"
			size: 0.75d
			subtitle: "bigger turbines, bigger power"
			tasks: [{
				count: 2L
				id: "1C00F1C2E3D40005"
				item: "gtceu:mv_steam_turbine"
				type: "item"
			}]
			title: "MV Power"
			x: 0.0d
			y: -1.5d
		}
		{
			dependencies: ["1C00F1C2E3D40004"]
			description: [
				"the &6MV extruder&r is the biggest quality-of-life upgrade in MV. one ingot plus the right mold outputs a rod, gear, pipe, ring, rotor, or bolt in a single recipe."
				""
				"skip the LV extruder entirely. if you made one by accident, recycle it in the arc furnace. the MV version does everything the LV does, with more shapes and faster."
			]
			icon: "gtceu:mv_extruder"
			id: "1C00F1C2E3D40008"
			shape: "gear"
			size: 1.2d
			subtitle: "one machine, every shape"
			tasks: [{
				id: "1C00F1C2E3D40009"
				item: "gtceu:mv_extruder"
				type: "item"
			}]
			title: "The Extruder"
			x: 0.0d
			y: -3.0d
		}
		{
			dependencies: ["1C00F1C2E3D40008"]
			description: [
				"&aethylene&r is the feedstock for polyethylene. the cleanest route: wood -> bio chaff (macerator) -> biomass (pyrolyse oven) -> ethanol (distillery) -> ethylene (chemical reactor with sulfuric acid)."
				""
				"the &6pyrolyse oven&r converts wood to biomass and produces wood tar as a byproduct. the &6MV distillery&r pulls ethanol from biomass one fluid at a time. get both running before you need PE."
			]
			icon: "gtceu:mv_distillery"
			id: "1C00F1C2E3D4000B"
			shape: "square"
			size: 0.75d
			subtitle: "wood goes in, chemistry comes out"
			tasks: [
				{
					id: "1C00F1C2E3D4000C"
					item: "gtceu:pyrolyse_oven"
					type: "item"
				}
				{
					id: "1C00F1C2E3D4000D"
					item: "gtceu:mv_distillery"
					type: "item"
				}
			]
			title: "Biomass Route"
			x: 0.0d
			y: -4.5d
		}
		{
			dependencies: ["1C00F1C2E3D4000B"]
			description: [
				"ethanol + sulfuric acid -> ethylene + water. ethylene + oxygen -> &apolyethylene&r fluid. PE fluid -> fluid solidifier -> PE plates."
				""
				"PE unlocks plastic PCBs, transistors, capacitors, and super tanks. everything MV circuit-related runs on plastic. get a continuous supply running before starting the circuit line."
			]
			icon: "gtceu:mv_chemical_reactor"
			id: "1C00F1C2E3D4000F"
			shape: "gear"
			size: 1.2d
			subtitle: "plastic: the oil of MV"
			tasks: [
				{
					id: "1C00F1C2E3D40010"
					item: "gtceu:mv_chemical_reactor"
					type: "item"
				}
				{
					count: 4L
					id: "1C00F1C2E3D40011"
